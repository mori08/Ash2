{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python .claude/hooks/check-commit-count.py",
            "statusMessage": "コミット数を確認中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [],
    "allow": [
      "Bash(./tools/run-format.sh *)",
      "Bash(./tools/run-tidy.sh *)",
      "Bash(./tools/build.sh *)",
      "Bash(./tools/run-tests.sh *)",
      "Bash(./tools/run.sh *)",
      "Edit(tmp/*)",
      "Bash(rm tmp/*)"
    ]
  }
}
