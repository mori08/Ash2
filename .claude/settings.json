{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "count=$(cd \"$(git rev-parse --show-toplevel 2>/dev/null)\" 2>/dev/null && git log main..HEAD --oneline 2>/dev/null | wc -l | tr -d ' '); if [ \"${count:-0}\" -gt 1 ]; then printf '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"additionalContext\":\"警告: main..HEAD に %s 件のコミットがあります。GIT.md のルール: 軽微な修正は直前のコミットに squash してから push すること。\"}}' \"$count\"; fi",
            "statusMessage": "コミット数を確認中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh api*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(./tools/run-format.sh *)",
      "Bash(./tools/run-tidy.sh *)",
      "Bash(./tools/build.sh*)",
      "Bash(./tools/run.sh*)"
    ]
  }
}
