{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .claude/hooks/no-compound-git.py"
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "python3 .claude/hooks/check-commit-count.py",
            "statusMessage": "コミット数を確認中..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(gh api*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git branch*)",
      "Bash(git checkout *)",
      "Bash(git rev-parse *)",
      "Bash(git show *)",
      "Bash(gh issue *)",
      "Bash(gh pr *)",
      "Bash(gh label *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(./tools/run-format.sh *)",
      "Bash(./tools/run-tidy.sh *)",
      "Bash(./tools/build.sh*)",
      "Bash(./tools/run.sh*)",
      "Bash(./tools/run-tests.sh*)"
    ]
  }
}
