# 改行コードの自動変換（リポジトリ内はLF、Windows checkout時はCRLF）
* text=auto

# バイナリファイルは変換しない
*.png binary
*.jpg binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.ttf binary
*.otf binary
*.dll binary
*.exe binary
*.sf2 binary
*.zstdcmp binary
*.zip binary

# シェルスクリプトは常に LF
*.sh text eol=lf
tools/hooks/pre-commit text eol=lf

# 自動生成ファイルは改行変換しない
Ash2/App/assets/asset_list -text
